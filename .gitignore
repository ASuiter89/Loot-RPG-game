# Local, machine-specific Claude Code settings (permissions etc.) — not shared.
.claude/settings.local.json

# Scratch: third-party terrain tileset candidates downloaded for evaluation.
# These are not part of the game (the game is a single self-contained index.html).
cand/

# Node deps installed only for local headless verification (not part of the game).
node_modules/

# Vite build output (static bundle) — generated, not committed. GitHub Pages
# builds this from source on deploy.
dist/

# Vitest coverage reports.
coverage/

# Local preview screenshots (generated by scripts/terrain-preview-shot.mjs).
scratch-shots/

# Skill-icon pipeline cache: transparent sources + composed tiles, regenerated by
# tools/skill-icons/{generate,pack}.mjs. Not committed (the packed sheet lives in
# src/assets/skillIconsAtlas.js).
tools/skill-icons/.work/

# Hero walk sheets are intermediates: the shipped copy is base64 inside
# HERO_WALK in src/legacy/game.js, and art/hero-walk/build-sheets.py rebuilds
# these from the GIF masters on demand.
art/hero-walk/sheet_*.png
